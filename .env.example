# Sao chép thành .env rồi điền giá trị. KHÔNG commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

DB_PATH=app.db

# LLM: nhóm chốt nhà cung cấp và model ở tuần 1
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# docker: chạy code trong container (bắt buộc khi demo). local: chạy thẳng trên máy, CHỈ để phát triển.
SANDBOX_MODE=docker
SANDBOX_IMAGE=kt-sandbox
