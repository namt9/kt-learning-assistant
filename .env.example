# Sao chép thành .env rồi điền giá trị. KHÔNG commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

DB_PATH=app.db

# LLM: thử lần lượt theo thứ tự, provider đầu tiên trả lời được sẽ được dùng
LLM_PROVIDERS=claude,ollama
# Claude (mặc định). Lấy key tại console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Claude qua Microsoft Foundry (Azure): đặt 2 biến dưới, để trống ANTHROPIC_API_KEY;
# CLAUDE_MODEL là tên deployment trên Foundry (vd. claude-sonnet-4-6)
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# GPT/DeepSeek trên Azure (provider "azure"): mặc định dùng chung resource và key ở trên
AZURE_OPENAI_DEPLOYMENT=gpt-5.5
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# Ollama (dự phòng khi mất mạng / hết hạn mức): docker compose --profile ollama up -d
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Model chạy bằng CPU: mỗi lần chẩn đoán 1-3 phút
OLLAMA_TIMEOUT=300
# Số luồng CPU cho Ollama (0 = để Ollama tự chọn). Máy chip lai Intel Core Ultra / thế hệ 12+:
# đặt bằng khoảng nửa số nhân (vd. 6) nếu mỗi lượt chậm bất thường (> 5 phút)
OLLAMA_NUM_THREAD=0

# docker: chạy code trong container (bắt buộc khi demo). local: chạy thẳng trên máy, CHỈ để phát triển.
SANDBOX_MODE=docker
SANDBOX_IMAGE=kt-sandbox
