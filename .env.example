# Sao chép thành .env rồi điền giá trị. KHÔNG commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

DATABASE_URL=sqlite:///./app.db

# LLM: nhóm chốt nhà cung cấp và model ở tuần 1
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

SANDBOX_IMAGE=kt-sandbox
SANDBOX_TIME_LIMIT_S=2
SANDBOX_MEMORY_MB=256
