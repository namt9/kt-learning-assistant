    <rdfs:label xml:lang="vi">Cấu trúc (struct)</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">struct</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
