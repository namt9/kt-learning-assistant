  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#DANGLING_PTR">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Dùng con trỏ sau khi đã free / trỏ tới biến cục bộ đã hết phạm vi</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DANGLING_PTR</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Con trỏ đang trỏ tới vùng nhớ đã bị giải phóng hoặc đã hết phạm vi. Không trả về địa chỉ biến cục bộ, và không dùng con trỏ sau khi free.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro" />
