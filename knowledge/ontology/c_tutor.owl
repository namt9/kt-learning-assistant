    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_custom_rule" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_ASAN_GO_LOI" />
