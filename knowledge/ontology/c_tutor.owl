  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_DOC_THONG_BAO_LOI">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Explanation" />
    <rdfs:label xml:lang="vi">Cách đọc thông báo lỗi của trình biên dịch</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_DOC_THONG_BAO_LOI</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đọc lỗi ĐẦU TIÊN, xem tên file:dòng:cột, đọc phần "error:" rồi nhìn cả dòng đó và dòng phía trên. Các lỗi phía sau thường là hệ quả của lỗi đầu.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cu_phap" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_GO_LOI_CU_PHAP">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#DebuggingExercise" />
    <rdfs:label xml:lang="vi">Sửa 5 lỗi cú pháp trong một chương trình ngắn</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_GO_LOI_CU_PHAP</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cho chương trình thiếu ";", thiếu "}", sai tên biến và thiếu</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cu_phap" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#bien" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_KHOI_TAO_GIAI_THICH">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Explanation" />
    <rdfs:label xml:lang="vi">Vì sao biến cục bộ phải được khởi tạo</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_KHOI_TAO_GIAI_THICH</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biến cục bộ nằm trên stack và mang "giá trị rác" còn sót lại. Biến cộng dồn (sum, count) phải gán 0 trước vòng lặp; biến tìm max/min gán bằng phần tử đầu tiên.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#khoi_tao" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#bien" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_KHOI_TAO_TRUC_QUAN">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Visualization" />
    <rdfs:label xml:lang="vi">Quan sát giá trị rác của biến chưa khởi tạo</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_KHOI_TAO_TRUC_QUAN</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chạy từng bước bằng debugger (hoặc Python Tutor cho C), theo dõi ô nhớ của sum trước và sau khi gán 0.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#khoi_tao" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#bo_nho" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_visual" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_BIEN_KHONG_DUNG">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Quiz" />
    <rdfs:label xml:lang="vi">Biến này dùng để làm gì?</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_BIEN_KHONG_DUNG</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Với mỗi biến khai báo, hãy trả lời nó lưu gì và được đọc ở dòng nào. Biến không được đọc ở đâu thường là dấu hiệu dùng nhầm sang biến khác.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#bien" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CHIA_NGUYEN_VI_DU">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#WorkedExample" />
    <rdfs:label xml:lang="vi">5 / 2 bằng 2: chia nguyên và chia thực</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_CHIA_NGUYEN_VI_DU</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">So sánh printf("%f", 5/2), printf("%f", 5.0/2) và printf("%f", (double)5/2). Kết quả phép chia phụ thuộc kiểu toán hạng, không phụ thuộc kiểu biến nhận.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#ep_kieu" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#kieu_du_lieu" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CHIA_NGUYEN_BAI_TAP">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Exercise" />
    <rdfs:label xml:lang="vi">Luyện tập tính trung bình đúng kiểu</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_CHIA_NGUYEN_BAI_TAP</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Làm bài P003, bảo đảm in đúng 2 chữ số thập phân với mọi bộ test.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#ep_kieu" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#vong_lap" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
    <ct:usesProblem rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#P003" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_TRAN_SO_TRUC_QUAN">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Visualization" />
    <rdfs:label xml:lang="vi">Bảng phạm vi giá trị các kiểu số nguyên</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_TRAN_SO_TRUC_QUAN</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bảng so sánh int (±2.1×10^9), long long (±9.2×10^18), unsigned. Minh họa INT_MAX + 1 quay vòng thành số âm.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tran_so" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#kieu_du_lieu" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_visual" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_TRAN_SO_BAI_TAP">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Exercise" />
    <rdfs:label xml:lang="vi">Tính tổng với số rất lớn</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_TRAN_SO_BAI_TAP</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Làm bài P001 với test 4 số 10^9; chọn kiểu cho biến tổng để không bị tràn.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tran_so" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#kieu_du_lieu" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
    <ct:usesProblem rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#P001" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_DINH_DANG_BANG">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Visualization" />
    <rdfs:label xml:lang="vi">Bảng đặc tả định dạng printf/scanf</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_DINH_DANG_BANG</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bảng tra: int %d, long %ld, long long %lld, unsigned %u, char %c, chuỗi %s, float %f, double %f (printf) / %lf (scanf).</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhap_xuat" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#kieu_du_lieu" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_visual" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_GAN_VA_SO_SANH">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#WorkedExample" />
    <rdfs:label xml:lang="vi">"=" là gán, "==" là so sánh</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_GAN_VA_SO_SANH</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">if (x = 0) gán 0 cho x rồi kiểm tra 0 nên luôn sai. Mẹo viết hằng ở bên trái (if (0 == x)) để trình biên dịch báo lỗi nếu gõ thiếu một dấu "=".</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#toan_tu" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cau_lenh_dieu_kien" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_GAN_VA_SO_SANH_GO_LOI">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#DebuggingExercise" />
    <rdfs:label xml:lang="vi">Tìm điều kiện sai trong 4 đoạn code</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_GAN_VA_SO_SANH_GO_LOI</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cho 4 đoạn if/while; đoán trước kết quả in ra, chạy thử, rồi sửa các điều kiện viết sai.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#toan_tu" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cau_lenh_dieu_kien" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_DIEU_KIEN_BANG_CHAN_TRI">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Visualization" />
    <rdfs:label xml:lang="vi">Lập bảng chân trị cho điều kiện</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_DIEU_KIEN_BANG_CHAN_TRI</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Liệt kê vài giá trị của biến và kết quả điều kiện. Nếu cột kết quả chỉ có một giá trị thì điều kiện luôn đúng hoặc luôn sai.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#toan_tu" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cau_lenh_dieu_kien" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_visual" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_KHOI_LENH_TRUC_QUAN">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Visualization" />
    <rdfs:label xml:lang="vi">Khối lệnh nào thuộc if/for?</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_KHOI_LENH_TRUC_QUAN</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tô màu phạm vi của if/for khi có và không có {}, và khi có ";" ngay sau ngoặc. Thụt lề không quyết định phạm vi, chỉ {} mới quyết định.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cu_phap" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#vong_lap" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cau_lenh_dieu_kien" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_visual" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_KHOI_LENH_GO_LOI">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#DebuggingExercise" />
    <rdfs:label xml:lang="vi">Sửa vòng lặp chỉ chạy một lần</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_KHOI_LENH_GO_LOI</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cho chương trình có "for (...);" và một if thiếu {}; chạy thử, giải thích kết quả, rồi sửa.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#vong_lap" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cu_phap" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_VONG_LAP_DUNG">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Explanation" />
    <rdfs:label xml:lang="vi">Kiểm tra điều kiện dừng của vòng lặp</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_VONG_LAP_DUNG</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Với mỗi vòng lặp, xác định biến điều khiển, giá trị đầu, bước thay đổi, và chứng minh điều kiện sẽ sai sau hữu hạn bước. Với đệ quy, xác định trường hợp cơ sở.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#vong_lap" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#de_quy" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_VONG_LAP_TRUC_QUAN">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Visualization" />
    <rdfs:label xml:lang="vi">Bảng theo dõi biến qua từng vòng lặp</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_VONG_LAP_TRUC_QUAN</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lập bảng giá trị i và điều kiện ở mỗi vòng (trace table) cho 3–4 vòng đầu để thấy biến có tiến về điều kiện dừng không.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#vong_lap" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_visual" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_DO_PHUC_TAP">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Explanation" />
    <rdfs:label xml:lang="vi">Ước lượng thời gian chạy theo n</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_DO_PHUC_TAP</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Máy chấm làm khoảng 10^8 phép tính mỗi giây. Với n = 10^5, thuật toán O(n^2) cần 10^10 phép tính nên sẽ quá giờ; hãy tìm cách O(n) hoặc O(n log n).</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#do_phuc_tap" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_HAM_TRA_VE">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#WorkedExample" />
    <rdfs:label xml:lang="vi">Mọi nhánh của hàm đều phải return</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_HAM_TRA_VE</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ví dụ hàm max(a, b) chỉ return trong nhánh if; sửa bằng else hoặc return cuối hàm. Vẽ sơ đồ các đường đi qua hàm để kiểm tra.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#ham" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cau_lenh_dieu_kien" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_visual" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CHIA_CHO_0">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#WorkedExample" />
    <rdfs:label xml:lang="vi">Kiểm tra mẫu số trước khi chia</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_CHIA_CHO_0</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ví dụ tính trung bình khi n có thể bằng 0; thêm if (n == 0) xử lý riêng. Phép % cũng bị lỗi khi chia cho 0.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#toan_tu" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cau_lenh_dieu_kien" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_SCANF_DIA_CHI">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Explanation" />
    <rdfs:label xml:lang="vi">Vì sao scanf cần "&amp;"</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_SCANF_DIA_CHI</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C truyền tham số theo giá trị, nên scanf chỉ ghi được vào biến nếu nhận ĐỊA CHỈ của biến. Tên mảng char đã là địa chỉ nên %s không cần "&amp;".</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhap_xuat" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#dia_chi" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#truyen_tham_chieu" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_SCANF_TRUC_QUAN">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Visualization" />
    <rdfs:label xml:lang="vi">Hình minh họa ô nhớ và địa chỉ khi gọi scanf</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_SCANF_TRUC_QUAN</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vẽ ô nhớ của n với địa chỉ 0x1000; scanf("%d", &amp;n) ghi vào 0x1000, còn scanf("%d", n) lấy giá trị rác của n làm địa chỉ.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#dia_chi" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_visual" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CON_TRO_NULL">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Explanation" />
    <rdfs:label xml:lang="vi">Kiểm tra con trỏ trước khi dùng</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_CON_TRO_NULL</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Khởi tạo con trỏ bằng NULL hoặc địa chỉ hợp lệ; kiểm tra kết quả malloc; kiểm tra p != NULL trước *p hoặc p-&gt;next.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro_null" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CON_TRO_TRUC_QUAN">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Visualization" />
    <rdfs:label xml:lang="vi">Vẽ sơ đồ hộp và mũi tên cho con trỏ</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_CON_TRO_TRUC_QUAN</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mỗi biến là một hộp; con trỏ là mũi tên tới hộp khác; NULL là mũi tên không trỏ tới đâu. Vẽ lại sơ đồ sau mỗi câu lệnh gán con trỏ.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro_null" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#dia_chi" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_visual" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CON_TRO_GO_LOI">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#DebuggingExercise" />
    <rdfs:label xml:lang="vi">Sửa lỗi duyệt danh sách liên kết</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_CON_TRO_GO_LOI</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cho hàm duyệt danh sách liên kết truy cập p-&gt;next khi p đã là NULL; chạy với AddressSanitizer, đọc báo lỗi và sửa điều kiện vòng lặp.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro_null" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#danh_sach_lien_ket" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_TRA_VE_DIA_CHI_CUC_BO">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#WorkedExample" />
    <rdfs:label xml:lang="vi">Không trả về địa chỉ biến cục bộ</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_TRA_VE_DIA_CHI_CUC_BO</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ví dụ hàm trả về &amp;x với x cục bộ; sau khi hàm kết thúc, vùng stack của x bị thu hồi. Sửa bằng cấp phát động hoặc truyền mảng từ nơi gọi.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#pham_vi_bien" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#stack_heap" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CHI_SO_MANG">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Visualization" />
    <rdfs:label xml:lang="vi">Chỉ số mảng từ 0 đến n-1</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_CHI_SO_MANG</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vẽ mảng 5 ô có chỉ số 0..4; đánh dấu ô a[5] nằm ngoài mảng. So sánh hai vòng lặp i &lt; n và i &lt;= n.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#mang" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#vong_lap" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_visual" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_BIEN_VONG_LAP_GIAI_THICH">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Explanation" />
    <rdfs:label xml:lang="vi">Quy tắc viết biên vòng lặp duyệt mảng</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_BIEN_VONG_LAP_GIAI_THICH</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Duyệt xuôi: for (i = 0; i &lt; n; i++). Duyệt ngược: for (i = n - 1; i &gt;= 0; i--). Kiểm tra bằng hai trường hợp biên: phần tử đầu và phần tử cuối.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#mang" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#vong_lap" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_MANG_BAI_TAP">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Exercise" />
    <rdfs:label xml:lang="vi">Luyện duyệt mảng không vượt biên</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_MANG_BAI_TAP</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Làm bài P001 rồi P002, chạy thử với n = 1 (trường hợp biên nhỏ nhất).</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#mang" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#vong_lap" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
    <ct:usesProblem rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#P001" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_TRAN_BO_DEM">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Explanation" />
    <rdfs:label xml:lang="vi">Hậu quả của việc ghi ra ngoài mảng</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_TRAN_BO_DEM</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C không kiểm tra chỉ số mảng. Ghi ra ngoài có thể đè lên biến khác, làm chương trình chạy sai ngẫu nhiên hoặc crash; chương trình qua hết test vẫn có thể chứa lỗi này.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tran_bo_dem" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#mang" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#bo_nho" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_ASAN_GO_LOI">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#DebuggingExercise" />
    <rdfs:label xml:lang="vi">Dùng AddressSanitizer để tìm lỗi bộ nhớ</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_ASAN_GO_LOI</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biên dịch với -fsanitize=address -g, chạy lại, đọc dòng "ERROR:" và dòng "#0 ... main.c:N" để biết lỗi xảy ra ở đâu.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tran_bo_dem" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#bo_nho" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_STACK_HEAP_TRUC_QUAN">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Visualization" />
    <rdfs:label xml:lang="vi">Sơ đồ bộ nhớ stack và heap</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_STACK_HEAP_TRUC_QUAN</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vẽ con trỏ a trên stack trỏ tới vùng 5 phần tử trên heap. Khi hàm kết thúc, a biến mất nhưng vùng heap vẫn còn nếu chưa free (rò rỉ).</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#stack_heap" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cap_phat_dong" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#bo_nho" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_visual" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_MALLOC_FREE_QUY_TAC">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Explanation" />
    <rdfs:label xml:lang="vi">Quy tắc cặp malloc/free</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_MALLOC_FREE_QUY_TAC</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mỗi malloc/calloc có đúng một free tương ứng trên mọi đường thoát của hàm (kể cả return sớm). new đi với delete, new[] đi với delete[].</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#giai_phong_bo_nho" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#quan_ly_bo_nho" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_MALLOC_BAI_TAP">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Exercise" />
    <rdfs:label xml:lang="vi">Luyện tập cấp phát và giải phóng mảng động</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_MALLOC_BAI_TAP</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Làm bài P002, chạy với AddressSanitizer để bảo đảm không còn "detected memory leaks".</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cap_phat_dong" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#giai_phong_bo_nho" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
    <ct:usesProblem rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#P002" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_FREE_GAN_NULL">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#WorkedExample" />
    <rdfs:label xml:lang="vi">Gán NULL ngay sau khi free</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_FREE_GAN_NULL</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ví dụ free(p) hai lần gây crash; sửa bằng free(p); p = NULL; vì free(NULL) là an toàn. Tương tự, không dùng p sau khi free.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#giai_phong_bo_nho" />
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro_null" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_verbal" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_active" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_SO_HUU_BO_NHO">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Quiz" />
    <rdfs:label xml:lang="vi">Ai chịu trách nhiệm giải phóng vùng nhớ này?</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PA_SO_HUU_BO_NHO</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</ct:level>
    <ct:content rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Với mỗi lần cấp phát trong chương trình, trả lời hàm nào giải phóng và ở dòng nào. Một vùng không có câu trả lời là rò rỉ; một vùng có hai câu trả lời là free hai lần.</ct:content>
    <ct:teaches rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#quan_ly_bo_nho" />
    <ct:suitsStyle rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#style_reflective" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#SYNTAX_ERROR">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Lỗi cú pháp (thiếu ;, ngoặc, ...)</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYNTAX_ERROR</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đọc dòng lỗi đầu tiên mà trình biên dịch báo; thường thiếu dấu ";" hoặc ngoặc ở ngay dòng đó hoặc dòng phía trên.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cu_phap" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_DOC_THONG_BAO_LOI" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_GO_LOI_CU_PHAP" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#UNDECLARED_ID">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Dùng biến/hàm chưa khai báo</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UNDECLARED_ID</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biến hoặc hàm phải được khai báo trước khi dùng. Kiểm tra chính tả tên và phạm vi (scope) của biến; hàm thư viện cần</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#bien" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#ham" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_DOC_THONG_BAO_LOI" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_GO_LOI_CU_PHAP" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#TYPE_MISMATCH">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Sai kiểu dữ liệu khi gán / truyền tham số</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TYPE_MISMATCH</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kiểu của giá trị không khớp với kiểu biến hoặc tham số. Xem lại khai báo hàm và kiểu từng đối số.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#kieu_du_lieu" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#ham" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_DOC_THONG_BAO_LOI" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#UNINIT_VAR">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Dùng biến chưa khởi tạo</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UNINIT_VAR</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biến cục bộ trong C không tự bằng 0. Hãy gán giá trị ban đầu (ví dụ int sum = 0;) trước khi đọc hoặc cộng dồn.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#bien" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#khoi_tao" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_cppcheck" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_KHOI_TAO_GIAI_THICH" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_KHOI_TAO_TRUC_QUAN" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#UNUSED_VAR">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Khai báo biến nhưng không dùng</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UNUSED_VAR</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biến được khai báo nhưng không dùng. Có thể bạn đã dùng nhầm sang một biến khác cùng mục đích.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#bien" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_cppcheck" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_BIEN_KHONG_DUNG" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#ASSIGN_IN_COND">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Dùng "=" thay cho "==" trong điều kiện</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ASSIGN_IN_COND</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trong điều kiện, "=" là phép gán, còn so sánh bằng phải dùng "==".</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#toan_tu" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cau_lenh_dieu_kien" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_custom_rule" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_GAN_VA_SO_SANH" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_GAN_VA_SO_SANH_GO_LOI" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#CONST_CONDITION">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Điều kiện luôn đúng hoặc luôn sai</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CONST_CONDITION</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều kiện này luôn cho cùng một kết quả nên nhánh if/vòng lặp không bao giờ (hoặc luôn luôn) chạy. Thường do gán nhầm "=" thay "==", so sánh sai biến, hoặc điều kiện bị lặp.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cau_lenh_dieu_kien" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#toan_tu" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_cppcheck" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_custom_rule" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_GAN_VA_SO_SANH" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_GAN_VA_SO_SANH_GO_LOI" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_DIEU_KIEN_BANG_CHAN_TRI" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#STRAY_SEMICOLON">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Dấu ";" thừa ngay sau if/for/while</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STRAY_SEMICOLON</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dấu ";" ngay sau if(...)/for(...)/while(...) tạo ra thân rỗng, nên khối lệnh phía sau không còn thuộc câu lệnh đó.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cau_lenh_dieu_kien" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#vong_lap" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_custom_rule" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_KHOI_LENH_TRUC_QUAN" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_KHOI_LENH_GO_LOI" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#MISSING_BRACES">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Thiếu {} nên lệnh không thuộc khối if/for/while như ý định</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MISSING_BRACES</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Không có {} thì if/for/while chỉ áp dụng cho MỘT câu lệnh ngay sau nó; các dòng thụt lề phía dưới vẫn chạy bên ngoài. Hãy bọc khối lệnh trong {} (và kiểm tra dấu ";" thừa).</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cau_lenh_dieu_kien" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#vong_lap" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cu_phap" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_KHOI_LENH_TRUC_QUAN" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_KHOI_LENH_GO_LOI" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#SCANF_MISSING_AMP">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Thiếu "&amp;" khi đọc biến bằng scanf</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCANF_MISSING_AMP</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">scanf cần địa chỉ của biến để ghi giá trị vào, hãy viết scanf("%d", &amp;x). Riêng mảng ký tự đọc bằng %s thì không cần "&amp;".</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhap_xuat" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#dia_chi" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#truyen_tham_chieu" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_cppcheck" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_custom_rule" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_DINH_DANG_BANG" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_SCANF_DIA_CHI" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_SCANF_TRUC_QUAN" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#FORMAT_MISMATCH">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Đặc tả định dạng printf/scanf không khớp kiểu</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FORMAT_MISMATCH</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đặc tả định dạng phải khớp kiểu biến, ví dụ %d cho int, %ld cho long, %lld cho long long, %f cho float/double khi in, %lf cho double khi đọc.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhap_xuat" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#kieu_du_lieu" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_cppcheck" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_DINH_DANG_BANG" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#INT_DIVISION">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Chia nguyên ngoài ý muốn</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INT_DIVISION</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chia hai số nguyên trong C cho kết quả nguyên (5/2 = 2). Muốn ra số thực, hãy ép kiểu một toán hạng, ví dụ (double)a / b.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#kieu_du_lieu" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#ep_kieu" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#toan_tu" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_custom_rule" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CHIA_NGUYEN_VI_DU" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CHIA_NGUYEN_BAI_TAP" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#INT_OVERFLOW">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Tràn số nguyên</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INT_OVERFLOW</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kết quả vượt quá phạm vi của kiểu int (khoảng ±2.1 tỉ). Hãy dùng long long cho tổng hoặc tích lớn.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#kieu_du_lieu" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tran_so" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_ubsan" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_TRAN_SO_TRUC_QUAN" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_TRAN_SO_BAI_TAP" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#DIV_BY_ZERO">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Chia cho 0</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIV_BY_ZERO</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Có phép chia (hoặc %) mà mẫu số bằng 0. Hãy kiểm tra mẫu số trước khi chia.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#toan_tu" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_cppcheck" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_ubsan" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_custom_rule" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CHIA_CHO_0" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#MISSING_RETURN">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Hàm có kiểu trả về nhưng thiếu return</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MISSING_RETURN</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hàm khai báo có giá trị trả về nhưng có nhánh kết thúc mà không có return. Hãy bảo đảm mọi nhánh đều return.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#ham" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_cppcheck" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_HAM_TRA_VE" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#OFF_BY_ONE">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Sai biên vòng lặp (lệch một phần tử)</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OFF_BY_ONE</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mảng n phần tử có chỉ số từ 0 đến n-1. Vòng lặp bắt đầu từ 0 thì điều kiện thường là i &lt; n, không phải i &lt;= n.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#vong_lap" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#mang" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_custom_rule" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_VONG_LAP_TRUC_QUAN" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CHI_SO_MANG" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_BIEN_VONG_LAP_GIAI_THICH" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_MANG_BAI_TAP" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#ARRAY_OOB">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Truy cập mảng ngoài phạm vi</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARRAY_OOB</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chương trình đọc hoặc ghi ra ngoài vùng nhớ của mảng. Hãy kiểm tra chỉ số lớn nhất và kích thước khai báo của mảng.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#mang" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tran_bo_dem" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#bo_nho" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_gcc" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_cppcheck" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_asan" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_ubsan" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CHI_SO_MANG" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_MANG_BAI_TAP" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_TRAN_BO_DEM" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_ASAN_GO_LOI" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#NULL_DEREF">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Giải tham chiếu con trỏ NULL</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NULL_DEREF</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Con trỏ đang là NULL (hoặc chưa trỏ tới vùng nhớ hợp lệ) mà vẫn được dùng. Hãy kiểm tra kết quả malloc và khởi tạo con trỏ trước khi dùng.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro_null" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_cppcheck" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_asan" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_ubsan" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_KHOI_TAO_TRUC_QUAN" />
