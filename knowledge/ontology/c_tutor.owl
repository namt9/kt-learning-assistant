  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#UNCLASSIFIED">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Cảnh báo chưa phân loại</rdfs:label>
