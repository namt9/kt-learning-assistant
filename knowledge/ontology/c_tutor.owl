    <rdfs:label xml:lang="vi">Chuỗi ký tự</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chuoi</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
