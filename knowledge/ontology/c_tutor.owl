    <ct:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vùng nhớ có tên và kiểu; khai báo trước khi dùng.</ct:description>
    <ct:partOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhom_bien" />
