  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#INFINITE_LOOP">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Vòng lặp không dừng / thuật toán quá chậm</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INFINITE_LOOP</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chương trình chạy quá thời gian cho phép. Hãy kiểm tra điều kiện dừng và biến đếm của vòng lặp, hoặc giảm độ phức tạp thuật toán.</ct:hint>
