    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biến lưu địa chỉ; khai báo T *p; giải tham chiếu *p.</ct:description>
    <ct:partOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhom_con_tro" />
