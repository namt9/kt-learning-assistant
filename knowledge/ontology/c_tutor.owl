    <ct:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ước lượng số phép tính theo kích thước dữ liệu (O(n), O(n^2)...), giới hạn thời gian.</ct:description>
    <ct:partOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhom_nen_tang" />
