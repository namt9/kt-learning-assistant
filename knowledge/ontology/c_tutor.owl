  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cap_phat_dong">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Concept" />
    <rdfs:label xml:lang="vi">Cấp phát động</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cap_phat_dong</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">malloc/calloc/realloc (C), new/new[] (C++); kiểm tra kết quả NULL.</ct:description>
    <ct:partOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhom_bo_nho" />
    <ct:hasPrerequisite rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro" />
    <ct:hasPrerequisite rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#stack_heap" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#giai_phong_bo_nho">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Concept" />
    <rdfs:label xml:lang="vi">Giải phóng bộ nhớ</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">giai_phong_bo_nho</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">free/delete/delete[]; mỗi vùng cấp phát giải phóng đúng một lần.</ct:description>
    <ct:partOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhom_bo_nho" />
    <ct:hasPrerequisite rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cap_phat_dong" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#quan_ly_bo_nho">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Concept" />
