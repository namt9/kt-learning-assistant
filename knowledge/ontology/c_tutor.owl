    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_CON_TRO_GO_LOI" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#MEM_LEAK">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Rò rỉ bộ nhớ (malloc/new không giải phóng)</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MEM_LEAK</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vùng nhớ cấp phát bằng malloc/calloc/new phải được giải phóng bằng free/delete khi không dùng nữa.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#cap_phat_dong" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#giai_phong_bo_nho" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#quan_ly_bo_nho" />
    <ct:detectedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tool_cppcheck" />
