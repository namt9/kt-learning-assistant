    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quan_ly_bo_nho</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</ct:level>
    <ct:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ai cấp phát thì ai giải phóng; gán NULL sau khi free; tránh rò rỉ khi return sớm.</ct:description>
    <ct:partOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhom_bo_nho" />
    <ct:hasPrerequisite rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#giai_phong_bo_nho" />
    <ct:hasPrerequisite rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#ham" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#tran_bo_dem">
