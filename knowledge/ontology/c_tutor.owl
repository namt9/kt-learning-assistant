    <ct:hasPrerequisite rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#vong_lap" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#mang_2_chieu">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Concept" />
    <rdfs:label xml:lang="vi">Mảng hai chiều</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mang_2_chieu</ct:identifier>
