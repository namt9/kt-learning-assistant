    <ct:partOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhom_con_tro" />
    <ct:hasPrerequisite rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro" />
    <ct:hasPrerequisite rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#ham" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro_hai_cap">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Concept" />
    <rdfs:label xml:lang="vi">Con trỏ hai cấp</rdfs:label>
