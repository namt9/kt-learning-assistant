    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_MALLOC_FREE_QUY_TAC" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_MALLOC_BAI_TAP" />
    <ct:remediatedBy rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PA_SO_HUU_BO_NHO" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#DOUBLE_FREE">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern" />
    <rdfs:label xml:lang="vi">Giải phóng bộ nhớ hai lần</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DOUBLE_FREE</ct:identifier>
    <ct:hint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Một vùng nhớ chỉ được free một lần. Sau khi free hãy gán con trỏ = NULL để tránh free lại.</ct:hint>
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#giai_phong_bo_nho" />
    <ct:relatedTo rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#quan_ly_bo_nho" />
