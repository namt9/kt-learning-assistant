  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro_null">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Concept" />
    <rdfs:label xml:lang="vi">Con trỏ NULL và con trỏ chưa khởi tạo</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">con_tro_null</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ct:level>
    <ct:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NULL nghĩa là không trỏ tới đâu; luôn kiểm tra trước khi giải tham chiếu.</ct:description>
    <ct:partOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhom_con_tro" />
    <ct:hasPrerequisite rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro" />
    <ct:hasPrerequisite rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#khoi_tao" />
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#so_hoc_con_tro">
    <rdf:type rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Concept" />
    <rdfs:label xml:lang="vi">Số học con trỏ</rdfs:label>
    <ct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">so_hoc_con_tro</ct:identifier>
    <ct:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</ct:level>
    <ct:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p + i trỏ tới phần tử thứ i; liên hệ giữa a[i] và *(a + i).</ct:description>
    <ct:partOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#nhom_con_tro" />
    <ct:hasPrerequisite rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#con_tro" />
    <ct:hasPrerequisite rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#mang" />
  </owl:NamedIndividual>
