<?xml version='1.0' encoding='utf-8'?>
<rdf:RDF xmlns:ct="http://www.semanticweb.org/cs2307/ontologies/c-tutor#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="http://www.semanticweb.org/cs2307/ontologies/c-tutor">
  <owl:Ontology rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor">
    <rdfs:label xml:lang="vi">Ontology trợ lý học lập trình C/C++ (Multi-Agent + Knowledge Graph)</rdfs:label>
    <rdfs:comment xml:lang="vi">Sinh tự động từ knowledge/*.yaml bởi backend/app/kg/owl.py, không sửa tay.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Concept">
    <rdfs:label xml:lang="vi">Khái niệm</rdfs:label>
    <rdfs:comment xml:lang="vi">Khái niệm lập trình C/C++ trong Concept Map.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#ConceptGroup">
    <rdfs:label xml:lang="vi">Cụm khái niệm</rdfs:label>
    <rdfs:comment xml:lang="vi">Biến, Con trỏ, CTDL, Quản lý bộ nhớ, Nền tảng.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#BugPattern">
    <rdfs:label xml:lang="vi">Mẫu lỗi</rdfs:label>
    <rdfs:comment xml:lang="vi">Loại lỗi sinh viên hay mắc (Bug_Pattern).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PedagogicalAction">
    <rdfs:label xml:lang="vi">Hành động sư phạm</rdfs:label>
    <rdfs:comment xml:lang="vi">Cách khắc phục, dạy lại.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Problem">
    <rdfs:label xml:lang="vi">Bài tập</rdfs:label>
    <rdfs:comment xml:lang="vi">Bài tập lập trình có test case.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Student">
    <rdfs:label xml:lang="vi">Sinh viên</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#StudentCode">
    <rdfs:label xml:lang="vi">Bài nộp</rdfs:label>
    <rdfs:comment xml:lang="vi">Một lần nộp code của sinh viên (Student_Code).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#LearningStyle">
    <rdfs:label xml:lang="vi">Phong cách học</rdfs:label>
    <rdfs:comment xml:lang="vi">Felder–Silverman rút gọn 2 chiều.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#DetectionTool">
    <rdfs:label xml:lang="vi">Công cụ phát hiện</rdfs:label>
    <rdfs:comment xml:lang="vi">Công cụ phát hiện mẫu lỗi.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#MinedRule">
    <rdfs:label xml:lang="vi">Luật khai phá</rdfs:label>
    <rdfs:comment xml:lang="vi">Luật kết hợp khai phá bằng Apriori từ log nộp bài.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#AddRule">
    <rdfs:label xml:lang="vi">Luật bổ sung lỗi</rdfs:label>
    <rdfs:comment xml:lang="vi">Khi điều kiện đúng, dự đoán thêm một mẫu lỗi.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#MinedRule" />
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#SuppressRule">
    <rdfs:label xml:lang="vi">Luật khử nhiễu</rdfs:label>
    <rdfs:comment xml:lang="vi">Cảnh báo là hệ quả của lỗi khác nên bỏ qua.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#MinedRule" />
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Explanation">
    <rdfs:label xml:lang="vi">Giải thích</rdfs:label>
    <rdfs:comment xml:lang="vi">Hành động sư phạm loại GIAI_THICH.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PedagogicalAction" />
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#WorkedExample">
    <rdfs:label xml:lang="vi">Ví dụ mẫu</rdfs:label>
    <rdfs:comment xml:lang="vi">Hành động sư phạm loại VI_DU.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PedagogicalAction" />
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Visualization">
    <rdfs:label xml:lang="vi">Trực quan hoá</rdfs:label>
    <rdfs:comment xml:lang="vi">Hành động sư phạm loại TRUC_QUAN.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PedagogicalAction" />
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#DebuggingExercise">
    <rdfs:label xml:lang="vi">Bài tập gỡ lỗi</rdfs:label>
    <rdfs:comment xml:lang="vi">Hành động sư phạm loại GO_LOI.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PedagogicalAction" />
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Exercise">
    <rdfs:label xml:lang="vi">Bài tập luyện tập</rdfs:label>
    <rdfs:comment xml:lang="vi">Hành động sư phạm loại BAI_TAP.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PedagogicalAction" />
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/cs2307/ontologies/c-tutor#Quiz">
    <rdfs:label xml:lang="vi">Câu hỏi kiểm tra</rdfs:label>
    <rdfs:comment xml:lang="vi">Hành động sư phạm loại CAU_HOI.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cs2307/ontologies/c-tutor#PedagogicalAction" />
  </owl:Class>
